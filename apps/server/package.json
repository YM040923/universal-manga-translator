{
  "name": "@umt/server",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "pnpm build && node --test dist/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@umt/core": "workspace:*",
    "@fastify/cors": "^9.0.0",
    "@umt/shared": "workspace:*",
    "better-sqlite3": "^11.0.0",
    "fastify": "^4.28.0",
    "sharp": "^0.33.4",
    "tsx": "^4.16.0",
    "zod": "^3.23.8",
    "@fastify/websocket": "^10.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11"
  }
}
