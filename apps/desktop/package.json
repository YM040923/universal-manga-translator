{
  "name": "@umt/desktop",
  "version": "0.1.4",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "pnpm build && node --test dist/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm build && electron dist/main.js",
    "package": "pnpm --filter @umt/server build && pnpm build && node scripts/prepare-package.mjs && electron-builder --win portable --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron-builder": "^26.0.12",
    "electron": "^33.4.11"
  },
  "build": {
    "appId": "local.umt.desktop",
    "productName": "Universal Manga Translator",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/app-shell.js",
      "dist/backend-manager.js",
      "dist/main.js",
      "dist/preload.cjs",
      "dist/ui-state.js",
      "dist/window-config.js",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "asar": false,
    "extraResources": [
      {
        "from": "dist-server",
        "to": "server",
        "filter": [
          "**/*",
          "!data/**"
        ]
      }
    ]
  },
  "description": "Universal Manga Translator desktop controller",
  "author": "local"
}
