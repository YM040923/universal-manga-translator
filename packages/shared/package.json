{
  "name": "@umt/shared",
  "version": "0.1.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./types": { "types": "./dist/types.d.ts", "default": "./dist/types.js" },
    "./protocol": { "types": "./dist/protocol.d.ts", "default": "./dist/protocol.js" },
    "./geometry": { "types": "./dist/geometry.d.ts", "default": "./dist/geometry.js" },
    "./hashing": { "types": "./dist/hashing.d.ts", "default": "./dist/hashing.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test dist/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
