PORT=47831
TRANSLATION_PIPELINE=network-ocr-openai-compatible

# OpenAI-compatible 文本翻译
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 通用网络 OCR：更换 OCR 服务商时通常只需要改 OCR_API_URL 和 OCR_API_KEYS
OCR_API_URL=https://example.com/ocr
OCR_API_KEYS=
OCR_INPUT_MODE=image_base64
OCR_IMAGE_FIELD=image_base64
OCR_STATIC_FIELDS_JSON={"need_location":true,"enable_cls":false,"return_markdown":false}
OCR_REGIONS_PATHS=words_result,data.words_result,data.result,data.regions,result,regions
OCR_TEXT_PATHS=words,text,content
OCR_BOX_PATHS=location,box,bbox,vertexes_location
OCR_CONFIDENCE_PATHS=score,confidence

TARGET_LANGUAGE=zh-CN
MAX_IMAGE_LONG_EDGE=1600
JPEG_QUALITY=0.75
